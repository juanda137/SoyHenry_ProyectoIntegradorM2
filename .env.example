# ---------------------------------------------------------------------------
# Copiá este archivo a ".env" y completá la clave del proveedor que uses.
#   copy .env.example .env    (Windows)
#   cp .env.example .env      (Linux / macOS)
#
# El archivo .env NUNCA se sube al repositorio.
# ---------------------------------------------------------------------------

# Proveedor: "gemini" (tiene capa gratuita) u "openai".
LLM_PROVIDER=gemini

# Clave de Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Clave de OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-key-here

# Modelos. Vacío = el modelo por defecto del proveedor elegido:
#   openai -> EMBEDDING_MODEL=text-embedding-3-small   CHAT_MODEL=gpt-4o-mini
#   gemini -> EMBEDDING_MODEL=gemini-embedding-001     CHAT_MODEL=gemini-3.5-flash-lite
# Si cambiás EMBEDDING_MODEL, volvé a correr: python -m src.build_index
EMBEDDING_MODEL=
CHAT_MODEL=

# Modelo del agente evaluador. Vacío = el mismo que CHAT_MODEL.
EVALUATOR_MODEL=
